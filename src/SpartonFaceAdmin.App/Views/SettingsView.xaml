<UserControl x:Class="SpartonFaceAdmin.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters">
    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 1: SQL Databases -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Kết nối Cơ sở dữ liệu" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- HR Database -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="HR Database" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrandRoyalBrush}" VerticalAlignment="Center" />
                                    <Button Content="Kiểm tra"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,5"
                                            Command="{Binding TestHrConnectionCommand}"
                                            IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                                </Grid>

                                <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding HrServer}" Margin="0,0,0,8" />

                                <TextBlock Text="Database" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding HrDatabase}" Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding HrUsername}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="PbHrPassword" Style="{StaticResource ModernPasswordBox}" PasswordChanged="PbHrPassword_PasswordChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding HrTimeout}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Face Database -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Face Database" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrandRoyalBrush}" VerticalAlignment="Center" />
                                    <Button Content="Kiểm tra"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,5"
                                            Command="{Binding TestFaceConnectionCommand}"
                                            IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                                </Grid>

                                <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FaceServer}" Margin="0,0,0,8" />

                                <TextBlock Text="Database" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FaceDatabase}" Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FaceUsername}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="PbFacePassword" Style="{StaticResource ModernPasswordBox}" PasswordChanged="PbFacePassword_PasswordChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FaceTimeout}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Camera -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Nguồn Camera" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Button Content="Kiểm tra Camera"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,5"
                                    Command="{Binding TestCameraCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                        </Grid>

                        <!-- Source Selector -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="USB Webcam"
                                         GroupName="CamSource"
                                         FontSize="13.5"
                                         FontWeight="SemiBold"
                                         IsChecked="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=Usb}"
                                         Margin="0,0,22,0" />
                            <RadioButton Content="IP Camera"
                                         GroupName="CamSource"
                                         FontSize="13.5"
                                         FontWeight="SemiBold"
                                         IsChecked="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=IpCamera}"
                                         Margin="0,0,22,0" />
                            <RadioButton Content="DCAM 710"
                                         GroupName="CamSource"
                                         FontSize="13.5"
                                         FontWeight="SemiBold"
                                         IsChecked="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=Dcam710}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- USB Camera Settings -->
                            <StackPanel Grid.Column="0"
                                        IsEnabled="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=Usb}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Thiết bị USB" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding UsbCameras}"
                                                  SelectedItem="{Binding SelectedUsbCamera, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Quét lại"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Bottom"
                                            Height="36"
                                            Command="{Binding RefreshCameraDevicesCommand}" />
                                </Grid>

                                <TextBlock Text="Độ phân giải" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Resolutions}"
                                          SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>

                            <!-- IP Camera Settings -->
                            <StackPanel Grid.Column="2"
                                        IsEnabled="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=IpCamera}">
                                <TextBlock Text="Stream URL" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding IpCameraUrl}" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding IpCameraUsername}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="PbIpCamPassword" Style="{StaticResource ModernPasswordBox}" PasswordChanged="PbIpCamPassword_PasswordChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding IpCameraTimeout}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Khôi phục mặc định"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ResetDefaultsCommand}"
                    Margin="0,0,10,0" />
            <Button Content="Lưu thay đổi"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    MinWidth="140" />
        </StackPanel>
    </Grid>
</UserControl>
