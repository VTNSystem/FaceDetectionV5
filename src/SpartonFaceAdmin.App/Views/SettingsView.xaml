<UserControl x:Class="SpartonFaceAdmin.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters">
    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 1: SQL Databases -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Kết nối Cơ sở dữ liệu" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- HR Database -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="HR Database" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:Button Content="Kiểm tra"
                                               HorizontalAlignment="Right"
                                               Appearance="Secondary"
                                               MinHeight="32"
                                               Padding="12,4"
                                               Command="{Binding TestHrConnectionCommand}"
                                               IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="PlugConnected20" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding HrServer}" Margin="0,0,0,8" />

                                <TextBlock Text="Database" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding HrDatabase}" Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding HrUsername}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <ui:PasswordBox x:Name="PbHrPassword" PasswordChanged="PbHrPassword_PasswordChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding HrTimeout}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Face Database -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Face Database" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:Button Content="Kiểm tra"
                                               HorizontalAlignment="Right"
                                               Appearance="Secondary"
                                               MinHeight="32"
                                               Padding="12,4"
                                               Command="{Binding TestFaceConnectionCommand}"
                                               IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="PlugConnected20" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding FaceServer}" Margin="0,0,0,8" />

                                <TextBlock Text="Database" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding FaceDatabase}" Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding FaceUsername}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <ui:PasswordBox x:Name="PbFacePassword" PasswordChanged="PbFacePassword_PasswordChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding FaceTimeout}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Camera -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Nguồn Camera" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <ui:Button Content="Kiểm tra Camera"
                                       HorizontalAlignment="Right"
                                       Appearance="Secondary"
                                       MinHeight="32"
                                       Padding="12,4"
                                       Command="{Binding TestCameraCommand}"
                                       IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Camera20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="USB Webcam"
                                         GroupName="CamSource"
                                         FontSize="13.5"
                                         FontWeight="SemiBold"
                                         IsChecked="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=Usb}"
                                         Margin="0,0,22,0" />
                            <RadioButton Content="IP Camera"
                                         GroupName="CamSource"
                                         FontSize="13.5"
                                         FontWeight="SemiBold"
                                         IsChecked="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=IpCamera}"
                                         Margin="0,0,22,0" />
                            <RadioButton Content="DCAM 710"
                                         GroupName="CamSource"
                                         FontSize="13.5"
                                         FontWeight="SemiBold"
                                         IsChecked="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=Dcam710}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- USB Camera Settings -->
                            <StackPanel Grid.Column="0"
                                        IsEnabled="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=Usb}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Thiết bị USB" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding UsbCameras}"
                                                  SelectedItem="{Binding SelectedUsbCamera, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2"
                                               Content="Quét lại"
                                               Appearance="Secondary"
                                               VerticalAlignment="Bottom"
                                               Command="{Binding RefreshCameraDevicesCommand}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowClockwise20" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <TextBlock Text="Độ phân giải" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <ComboBox ItemsSource="{Binding Resolutions}"
                                          SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>

                            <!-- IP Camera Settings -->
                            <StackPanel Grid.Column="2"
                                        IsEnabled="{Binding CameraSourceType, Converter={StaticResource EnumEquals}, ConverterParameter=IpCamera}">
                                <TextBlock Text="Stream URL" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding IpCameraUrl}" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding IpCameraUsername}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <ui:PasswordBox x:Name="PbIpCamPassword" PasswordChanged="PbIpCamPassword_PasswordChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding IpCameraTimeout}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="Khôi phục mặc định"
                       Appearance="Secondary"
                       Command="{Binding ResetDefaultsCommand}"
                       IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                       Margin="0,0,10,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowReset20" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="Lưu thay đổi"
                       Appearance="Primary"
                       Command="{Binding SaveCommand}"
                       IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                       MinWidth="148">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
