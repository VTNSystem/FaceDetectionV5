<ui:FluentWindow x:Class="SpartonFaceAdmin.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SpartonFaceAdmin.App.ViewModels"
                 xmlns:views="clr-namespace:SpartonFaceAdmin.App.Views"
                 xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters"
                 Title="Spartronics Face Detection"
                 Width="1340"
                 Height="840"
                 MinWidth="1024"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackground}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontFamily="Segoe UI"
                 Icon="pack://application:,,,/Assets/face-locker-icon.ico">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
        <conv:SidebarWidthConverter x:Key="SidebarWidth" />
        <conv:StatusDotBrushConverter x:Key="StatusDotBrush" />
        <conv:ToastBrushConverter x:Key="ToastBrush" />

        <DataTemplate DataType="{x:Type vm:EnrollmentViewModel}">
            <views:EnrollmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaceListViewModel}">
            <views:FaceListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Unified Rework/FQC Navy TitleBar -->
        <ui:TitleBar DockPanel.Dock="Top"
                     Title="Spartronics Face Detection"
                     Height="40">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/face-locker-icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidth}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible MTC-Style Dark Gradient Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarGradientBrush}"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Brand Header + Collapse Toggle -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource SidebarBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                <Border Background="White" CornerRadius="6" Padding="8,5">
                                    <Image Source="pack://application:,,,/Assets/spartronics-logo.png"
                                           Height="22"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="FACE DETECTION"
                                           Foreground="{StaticResource BrandCyanBrush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Margin="2,7,0,0" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Appearance="Transparent"
                                       Foreground="White"
                                       MouseOverBackground="{StaticResource TitleBarButtonHoverBrush}"
                                       Command="{Binding ToggleSidebarCommand}"
                                       ToolTip="Thu gọn / Mở rộng menu"
                                       Padding="8"
                                       MinHeight="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top">
                                <ui:SymbolIcon Symbol="Navigation24" Foreground="White" FontSize="18" />
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- Bottom Connection Status -->
                    <Border DockPanel.Dock="Bottom"
                            Background="#500A1522"
                            BorderBrush="{StaticResource SidebarBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10,10">
                        <StackPanel>
                            <!-- Expanded Status -->
                            <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Kết nối DB"
                                               Foreground="#8CA6C4"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ui:Button HorizontalAlignment="Right"
                                               Appearance="Transparent"
                                               Foreground="{StaticResource BrandCyanBrush}"
                                               MouseOverBackground="{StaticResource TitleBarButtonHoverBrush}"
                                               Command="{Binding RefreshEmployeesAndHealthCommand}"
                                               Padding="6,2"
                                               MinHeight="24"
                                               ToolTip="Làm mới kết nối">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowClockwise20" Foreground="{StaticResource BrandCyanBrush}" FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Làm mới" Foreground="{StaticResource BrandCyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="8" Height="8" Fill="{Binding AppState.IsHrConnected, Converter={StaticResource StatusDotBrush}}" Margin="0,0,8,0" />
                                    <TextBlock Text="HR Database" Foreground="#E2E8F0" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding AppState.IsFaceConnected, Converter={StaticResource StatusDotBrush}}" Margin="0,0,8,0" />
                                    <TextBlock Text="Face Database" Foreground="#E2E8F0" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Collapsed Compact Status -->
                            <StackPanel HorizontalAlignment="Center"
                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Ellipse Width="8" Height="8" ToolTip="HR Database" Fill="{Binding AppState.IsHrConnected, Converter={StaticResource StatusDotBrush}}" Margin="0,0,6,0" />
                                    <Ellipse Width="8" Height="8" ToolTip="Face Database" Fill="{Binding AppState.IsFaceConnected, Converter={StaticResource StatusDotBrush}}" />
                                </StackPanel>
                                <ui:Button Appearance="Transparent"
                                           Foreground="White"
                                           MouseOverBackground="{StaticResource TitleBarButtonHoverBrush}"
                                           Command="{Binding RefreshEmployeesAndHealthCommand}"
                                           ToolTip="Làm mới kết nối"
                                           Padding="6"
                                           MinHeight="30">
                                    <ui:SymbolIcon Symbol="ArrowClockwise20" Foreground="{StaticResource BrandCyanBrush}" FontSize="16" />
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Links -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     GroupName="MainNav"
                                     ToolTip="Đăng ký"
                                     IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Enrollment}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static vm:NavSection.Enrollment}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PersonAdd24"
                                               FontSize="18"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Đăng ký"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     GroupName="MainNav"
                                     ToolTip="Danh sách"
                                     IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=FaceList}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static vm:NavSection.FaceList}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24"
                                               FontSize="18"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Danh sách"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     GroupName="MainNav"
                                     ToolTip="Cài đặt"
                                     IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="{x:Static vm:NavSection.Settings}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24"
                                               FontSize="18"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Cài đặt"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Workspace -->
            <Grid Grid.Column="1" Margin="16">
                <ContentControl Content="{Binding CurrentViewModel}" />

                <!-- Floating Toast Notification -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        Padding="14,10"
                        CornerRadius="8"
                        MaxWidth="440"
                        Background="{Binding Toast.Kind, Converter={StaticResource ToastBrush}}"
                        Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="99">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info20" Foreground="White" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Toast.Message}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
