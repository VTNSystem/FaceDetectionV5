<Window x:Class="SpartonFaceAdmin.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SpartonFaceAdmin.App.ViewModels"
        xmlns:views="clr-namespace:SpartonFaceAdmin.App.Views"
        xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters"
        Title="Sparton Face Admin"
        Width="1320"
        Height="820"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        Icon="pack://application:,,,/Assets/face-locker-icon.ico">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:StatusDotBrushConverter x:Key="StatusDotBrush" />
        <conv:ToastBrushConverter x:Key="ToastBrush" />

        <DataTemplate DataType="{x:Type vm:EnrollmentViewModel}">
            <views:EnrollmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaceListViewModel}">
            <views:FaceListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Deep Navy Spartronics Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrandNavyBrush}">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="14,18,14,22">
                    <Border Background="White" CornerRadius="8" Padding="10,7">
                        <Image Source="pack://application:,,,/Assets/spartronics-logo.png"
                               Height="26"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="FACE ADMIN"
                               Foreground="{StaticResource BrandCyanBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="4,10,0,0" />
                </StackPanel>

                <!-- Bottom Connection Status -->
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource BrandNavyDarkBrush}"
                        Margin="10,0,10,12"
                        Padding="12,10"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kết nối hệ thống" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Làm mới"
                                    Command="{Binding RefreshEmployeesAndHealthCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource BrandCyanBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Padding="0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse Width="8" Height="8" Fill="{Binding AppState.IsHrConnected, Converter={StaticResource StatusDotBrush}}" Margin="0,0,8,0" />
                            <TextBlock Text="HR Database" Foreground="#E2E8F0" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding AppState.IsFaceConnected, Converter={StaticResource StatusDotBrush}}" Margin="0,0,8,0" />
                            <TextBlock Text="Face Database" Foreground="#E2E8F0" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavMenuButton}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Enrollment}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavSection.Enrollment}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,12A4,4 0 1,0 12,4A4,4 0 0,0 12,12M12,14C7.58,14 4,16.24 4,19V20H20V19C20,16.24 16.42,14 12,14Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="Đăng ký" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavMenuButton}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=FaceList}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavSection.FaceList}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,5H20V7H4V5M4,11H20V13H4V11M4,17H20V19H4V17Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="Danh sách" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavMenuButton}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavSection.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="Cài đặt" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="18">
            <ContentControl Content="{Binding CurrentViewModel}" />

            <!-- Floating Toast Notification -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Padding="14,10"
                    CornerRadius="8"
                    MaxWidth="420"
                    Background="{Binding Toast.Kind, Converter={StaticResource ToastBrush}}"
                    Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="99">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" />
                </Border.Effect>
                <TextBlock Text="{Binding Toast.Message}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
