<UserControl x:Class="SpartonFaceAdmin.App.Views.FaceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters">
    <UserControl.Resources>
        <conv:MaskLabelConverter x:Key="MaskLabel" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Filter Bar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <ComboBox x:Name="CbEmployeeSearch"
                              Style="{StaticResource VirtualizedComboBox}"
                              ItemsSource="{Binding FilteredEmployees}"
                              SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                              DisplayMemberPath="DisplayLabel"
                              TextSearch.TextPath="DisplayLabel"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              DropDownOpened="CbEmployeeSearch_DropDownOpened"
                              SelectionChanged="CbEmployeeSearch_SelectionChanged" />
                    <TextBlock x:Name="TxtEmployeePlaceholder"
                               Text="Tìm mã/tên hoặc chọn nhân viên..."
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,36,0"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Opacity="0.7" />
                </Grid>

                <ui:Button Grid.Column="2"
                           Content="Xóa tất cả"
                           Appearance="Danger"
                           Command="{Binding DeleteAllForEmployeeCommand}"
                           MinWidth="116">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete20" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Grid + Preview/Export Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Operational DataGrid (identical to Rework/FQC Desktop) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <ui:DataGrid Style="{StaticResource OperationalDataGrid}"
                             ItemsSource="{Binding FaceRecords}"
                             SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Mã NV" Binding="{Binding Code}" Width="90" />
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding Fullname}" Width="*" />
                        <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="125" />
                        <DataGridTextColumn Header="Khẩu trang" Binding="{Binding HasFaceMask, Converter={StaticResource MaskLabel}}" Width="92" />
                        <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedDate, StringFormat='dd/MM/yyyy HH:mm'}" Width="138" />
                        <DataGridTemplateColumn Header="Thao tác" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Appearance="Danger"
                                               MinHeight="26"
                                               Padding="8,2"
                                               HorizontalAlignment="Center"
                                               ToolTip="Xóa mẫu này"
                                               Command="{Binding DataContext.DeleteSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Delete20" Foreground="White" FontSize="14" />
                                    </ui:Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <!-- Image Review & Card Export -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Xem ảnh &amp; Xuất thẻ" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ảnh toàn cảnh" Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="1" Background="#0B1324" CornerRadius="8" ClipToBounds="True">
                            <Image Source="{Binding PreviewFullImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ảnh khuôn mặt" Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="1" Background="#0B1324" CornerRadius="8" ClipToBounds="True">
                            <Image Source="{Binding PreviewFaceImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Thư mục lưu ảnh" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding SaveFolderPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Chọn thư mục..." />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Command="{Binding BrowseSaveFolderCommand}" ToolTip="Chọn thư mục">
                                <ui:SymbolIcon Symbol="FolderOpen20" />
                            </ui:Button>
                        </Grid>

                        <TextBlock Text="File Excel (.xlsx)" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Chọn file Excel..." />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Command="{Binding BrowseExcelFileCommand}" ToolTip="Chọn file Excel">
                                <ui:SymbolIcon Symbol="DocumentTable20" />
                            </ui:Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Lưu ảnh &amp; Excel"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding ExportSelectedCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Grid.Column="2"
                                       Content="Xuất tất cả"
                                       Appearance="Secondary"
                                       Command="{Binding ExportAllOfEmployeeCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
