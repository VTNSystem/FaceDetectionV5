<UserControl x:Class="SpartonFaceAdmin.App.Views.EnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters">
    <UserControl.Resources>
        <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="348" />
        </Grid.ColumnDefinitions>

        <!-- Left: Camera Viewport + Scale % Controls -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Camera & Scale Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Camera Source Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding ToggleCameraCommand}" MinWidth="128">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Bật Camera" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                            <Setter Property="Content" Value="Tắt Camera" />
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Mở ảnh..."
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadImageFileCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Preview Scale % Controls -->
                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Khung chụp:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0" />

                            <ToggleButton Content="Fit"
                                          Style="{StaticResource PillToggleButton}"
                                          IsChecked="{Binding IsFitMode, Mode=OneWay}"
                                          Command="{Binding SetFitModeCommand}"
                                          Padding="10,4"
                                          Margin="0,0,4,0" />

                            <Button Content="75%"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SetScalePresetCommand}"
                                    CommandParameter="75"
                                    Padding="8,4"
                                    FontSize="12"
                                    Margin="0,0,4,0" />
                            <Button Content="100%"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SetScalePresetCommand}"
                                    CommandParameter="100"
                                    Padding="8,4"
                                    FontSize="12"
                                    Margin="0,0,8,0" />

                            <Slider Width="118"
                                    Minimum="50"
                                    Maximum="150"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding ScalePercent, Mode=TwoWay}" />

                            <Border Background="{StaticResource BrandNavyBrush}"
                                    CornerRadius="5"
                                    Padding="8,3"
                                    Margin="8,0,0,0"
                                    MinWidth="46">
                                <TextBlock Text="{Binding ScaleBadgeText}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Preview Surface -->
                <Border Grid.Row="2"
                        Background="#0B1324"
                        CornerRadius="8"
                        ClipToBounds="True"
                        PreviewMouseWheel="Viewport_PreviewMouseWheel">
                    <Grid>
                        <!-- Mode 1: Fit to Viewport -->
                        <Viewbox Stretch="Uniform"
                                 Visibility="{Binding IsFitMode, Converter={StaticResource BoolToVis}}">
                            <Grid Width="{Binding FramePixelWidth}"
                                  Height="{Binding FramePixelHeight}"
                                  Visibility="{Binding HasPreviewContent, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding PreviewSource}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Left="{Binding FaceLeft}"
                                            Canvas.Top="{Binding FaceTop}"
                                            Width="{Binding FaceSize}"
                                            Height="{Binding FaceSize}"
                                            BorderBrush="{StaticResource BrandCyanBrush}"
                                            BorderThickness="4"
                                            CornerRadius="12"
                                            Visibility="{Binding HasDetectedFace, Converter={StaticResource BoolToVis}}" />
                                </Canvas>
                            </Grid>
                        </Viewbox>

                        <!-- Mode 2: Explicit % Scale with Smooth Scroll -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsFitMode, Converter={StaticResource InverseBoolToVis}}">
                            <Viewbox Stretch="Uniform"
                                     Width="{Binding ScaledViewportWidth}"
                                     Height="{Binding ScaledViewportHeight}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding HasPreviewContent, Converter={StaticResource BoolToVis}}">
                                <Grid Width="{Binding FramePixelWidth}"
                                      Height="{Binding FramePixelHeight}">
                                    <Image Source="{Binding PreviewSource}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas IsHitTestVisible="False">
                                        <Border Canvas.Left="{Binding FaceLeft}"
                                                Canvas.Top="{Binding FaceTop}"
                                                Width="{Binding FaceSize}"
                                                Height="{Binding FaceSize}"
                                                BorderBrush="{StaticResource BrandCyanBrush}"
                                                BorderThickness="4"
                                                CornerRadius="12"
                                                Visibility="{Binding HasDetectedFace, Converter={StaticResource BoolToVis}}" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                        </ScrollViewer>

                        <!-- Empty Camera Placeholder -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasPreviewContent, Converter={StaticResource InverseBoolToVis}}">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#16223B" HorizontalAlignment="Center">
                                <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"
                                      Fill="{StaticResource BrandCyanBrush}"
                                      Width="28" Height="28" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Camera đang tắt"
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Face Ready Pill Overlay -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12"
                                Padding="10,5"
                                CornerRadius="6"
                                Background="#B3003470"
                                Visibility="{Binding HasDetectedFace, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Đã nhận diện khuôn mặt" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right: Compact Enrollment Controls -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Thông tin đăng ký" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                <!-- Employee Search + List -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Nhân viên" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Tìm mã hoặc tên..."
                             Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding FilteredEmployees}"
                             SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                             DisplayMemberPath="DisplayLabel"
                             Height="168"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="1"
                             FontSize="13" />
                </StackPanel>

                <!-- Group & Mask Mode -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nhóm quyền" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngưỡng khớp" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding SimilarThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Mask Segmented Switch -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="Khẩu trang" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0"
                                      Content="Không khẩu trang"
                                      Style="{StaticResource PillToggleButton}"
                                      IsChecked="{Binding HasFaceMask, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="2"
                                      Content="Đeo khẩu trang"
                                      Style="{StaticResource PillToggleButton}"
                                      IsChecked="{Binding HasFaceMask, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Capture & Save Button -->
                <Button Grid.Row="4"
                        Content="Chụp &amp; Lưu"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CaptureAndSaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Height="44"
                        FontSize="14.5"
                        Margin="0,16,0,14" />

                <!-- Enrolled Samples for Selected Employee -->
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mẫu đã lưu" Style="{StaticResource FieldLabel}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedEmployeeFaces}"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="1"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Run Text="#" /><Run Text="{Binding Id}" />
                                            <Run Text=" · " /><Run Text="{Binding Group}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy HH:mm'}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Xóa"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,4"
                                            FontSize="11.5"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteFaceRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
