<UserControl x:Class="SpartonFaceAdmin.App.Views.EnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SpartonFaceAdmin.App.Converters">
    <UserControl.Resources>
        <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="346" />
        </Grid.ColumnDefinitions>

        <!-- Left: Camera Viewport + Scale % Controls -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Camera & Scale Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Camera Source Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button Command="{Binding ToggleCameraCommand}" MinWidth="132">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource SpartronicsUiButtonStyle}">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Setter Property="Content" Value="Bật Camera" />
                                    <Setter Property="Icon">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="Camera24" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                            <Setter Property="Appearance" Value="Danger" />
                                            <Setter Property="Content" Value="Tắt Camera" />
                                            <Setter Property="Icon">
                                                <Setter.Value>
                                                    <ui:SymbolIcon Symbol="CameraOff24" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Content="Mở ảnh..."
                                   Appearance="Secondary"
                                   Command="{Binding LoadImageFileCommand}"
                                   Margin="8,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Image24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <!-- Preview Scale % Controls -->
                    <Border Grid.Column="2"
                            Background="{StaticResource ApplicationBackground}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tỉ lệ:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0" />

                            <ToggleButton Content="Fit"
                                          Style="{StaticResource PillToggleButton}"
                                          IsChecked="{Binding IsFitMode, Mode=OneWay}"
                                          Command="{Binding SetFitModeCommand}"
                                          MinHeight="28"
                                          Padding="10,3"
                                          Margin="0,0,4,0" />

                            <ui:Button Content="75%"
                                       Appearance="Secondary"
                                       Command="{Binding SetScalePresetCommand}"
                                       CommandParameter="75"
                                       MinHeight="28"
                                       Padding="8,3"
                                       FontSize="12"
                                       Margin="0,0,4,0" />
                            <ui:Button Content="100%"
                                       Appearance="Secondary"
                                       Command="{Binding SetScalePresetCommand}"
                                       CommandParameter="100"
                                       MinHeight="28"
                                       Padding="8,3"
                                       FontSize="12"
                                       Margin="0,0,8,0" />

                            <Slider Width="118"
                                    Minimum="50"
                                    Maximum="150"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding ScalePercent, Mode=TwoWay}" />

                            <Border Background="{StaticResource BrandNavyBrush}"
                                    CornerRadius="5"
                                    Padding="8,3"
                                    Margin="8,0,0,0"
                                    MinWidth="46">
                                <TextBlock Text="{Binding ScaleBadgeText}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Preview Surface -->
                <Border Grid.Row="2"
                        Background="#0B1324"
                        CornerRadius="8"
                        ClipToBounds="True"
                        PreviewMouseWheel="Viewport_PreviewMouseWheel">
                    <Grid>
                        <!-- Mode 1: Fit to Viewport -->
                        <Viewbox Stretch="Uniform"
                                 Visibility="{Binding IsFitMode, Converter={StaticResource BoolToVis}}">
                            <Grid Width="{Binding FramePixelWidth}"
                                  Height="{Binding FramePixelHeight}"
                                  Visibility="{Binding HasPreviewContent, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding PreviewSource}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Left="{Binding FaceLeft}"
                                            Canvas.Top="{Binding FaceTop}"
                                            Width="{Binding FaceSize}"
                                            Height="{Binding FaceSize}"
                                            BorderBrush="{StaticResource BrandCyanBrush}"
                                            BorderThickness="4"
                                            CornerRadius="12"
                                            Visibility="{Binding HasDetectedFace, Converter={StaticResource BoolToVis}}" />
                                </Canvas>
                            </Grid>
                        </Viewbox>

                        <!-- Mode 2: Explicit % Scale with Smooth Scroll -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsFitMode, Converter={StaticResource InverseBoolToVis}}">
                            <Viewbox Stretch="Uniform"
                                     Width="{Binding ScaledViewportWidth}"
                                     Height="{Binding ScaledViewportHeight}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding HasPreviewContent, Converter={StaticResource BoolToVis}}">
                                <Grid Width="{Binding FramePixelWidth}"
                                      Height="{Binding FramePixelHeight}">
                                    <Image Source="{Binding PreviewSource}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas IsHitTestVisible="False">
                                        <Border Canvas.Left="{Binding FaceLeft}"
                                                Canvas.Top="{Binding FaceTop}"
                                                Width="{Binding FaceSize}"
                                                Height="{Binding FaceSize}"
                                                BorderBrush="{StaticResource BrandCyanBrush}"
                                                BorderThickness="4"
                                                CornerRadius="12"
                                                Visibility="{Binding HasDetectedFace, Converter={StaticResource BoolToVis}}" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                        </ScrollViewer>

                        <!-- Empty Camera Placeholder -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasPreviewContent, Converter={StaticResource InverseBoolToVis}}">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#162840" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Camera24" Foreground="{StaticResource BrandCyanBrush}" FontSize="28" />
                            </Border>
                            <TextBlock Text="Camera đang tắt"
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Face Ready Badge -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12"
                                Padding="10,5"
                                CornerRadius="6"
                                Background="#CC112236"
                                BorderBrush="{StaticResource BrandCyanBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasDetectedFace, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0" />
                                <TextBlock Text="Đã nhận diện khuôn mặt" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right: Enrollment Controls -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Đăng ký khuôn mặt" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                <!-- Employee Search + List -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Nhân viên" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Tìm hoặc nhập: MãNV - Tên không dấu"
                                Margin="0,0,0,6">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search20" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <Border Background="{StaticResource BrandCyanSoftBrush}"
                            BorderBrush="{StaticResource BrandCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,6"
                            Visibility="{Binding HasManualEntry, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ManualEntryBadge}"
                                   Foreground="{StaticResource HeadingBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <ListBox ItemsSource="{Binding FilteredEmployees}"
                             SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                             DisplayMemberPath="DisplayLabel"
                             Height="162"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             BorderThickness="1"
                             FontSize="13" />
                </StackPanel>

                <!-- Group & Threshold -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="106" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nhóm quyền" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngưỡng khớp" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding SimilarThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Mask Segmented Switch -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="Khẩu trang" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0"
                                      Content="Không khẩu trang"
                                      Style="{StaticResource PillToggleButton}"
                                      IsChecked="{Binding HasFaceMask, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="2"
                                      Content="Đeo khẩu trang"
                                      Style="{StaticResource PillToggleButton}"
                                      IsChecked="{Binding HasFaceMask, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Primary Action Button -->
                <ui:Button Grid.Row="4"
                           Content="Chụp &amp; Lưu"
                           Appearance="Primary"
                           Command="{Binding CaptureAndSaveCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                           HorizontalAlignment="Stretch"
                           Height="42"
                           FontSize="14"
                           Margin="0,14,0,14">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>

                <!-- Saved Face Samples -->
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mẫu đã lưu" Style="{StaticResource FieldLabel}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedEmployeeFaces}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             BorderThickness="1"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="#" /><Run Text="{Binding Id}" />
                                            <Run Text=" · " /><Run Text="{Binding Group}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy HH:mm'}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                               Appearance="Danger"
                                               MinHeight="28"
                                               Padding="8,3"
                                               ToolTip="Xóa mẫu này"
                                               Command="{Binding DataContext.DeleteFaceRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Delete20" Foreground="White" FontSize="14" />
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
