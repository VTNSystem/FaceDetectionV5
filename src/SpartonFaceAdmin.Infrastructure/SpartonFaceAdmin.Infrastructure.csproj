<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpartonFaceAdmin.Contracts\SpartonFaceAdmin.Contracts.csproj" />
    <ProjectReference Include="..\SpartonFaceAdmin.Core\SpartonFaceAdmin.Core.csproj" />
  </ItemGroup>

  <!-- Build .NET 4.8 LuxandBridge and stage it into bridge\ for all consumers (App, Tests, Publish) -->
  <Target Name="StageLuxandBridgeFiles" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\SpartonFaceAdmin.Bridge\SpartonFaceAdmin.Bridge.csproj"
             Properties="Configuration=$(Configuration);Platform=x64"
             Targets="Restore;Build" />
    <ItemGroup>
      <_BridgeOutputFiles Include="..\SpartonFaceAdmin.Bridge\bin\x64\$(Configuration)\net48\**\*.*"
                          Exclude="..\SpartonFaceAdmin.Bridge\bin\x64\$(Configuration)\net48\**\*.pdb;..\SpartonFaceAdmin.Bridge\bin\x64\$(Configuration)\net48\**\*.config" />
      <Content Include="@(_BridgeOutputFiles)">
        <Link>bridge\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>
</Project>
